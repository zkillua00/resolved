+    fn paint_inline_action_block(
+        action: &super::InputInlineAction,
+        origin: Point<Pixels>,
+        line_height: Pixels,
+        hovered: bool,
+        pressed: bool,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Bounds<Pixels> {
+        let style = window.text_style();
+        let font_size = style.font_size.to_pixels(window.rem_size()) * 0.9;
+        let color = if hovered || pressed {
+            cx.theme().foreground
+        } else {
+            cx.theme().muted_foreground
+        };
+        let run = TextRun {
+            len: action.label.len(),
+            font: style.font(),
+            color,
+            background_color: None,
+            underline: None,
+            strikethrough: None,
+        };
+        let label = window
+            .text_system()
+            .shape_line(action.label.clone(), font_size, &[run], None);
+        let action_bounds = Bounds::new(
+            origin - point(px(5.), px(0.)),
+            size(label.width + px(10.), line_height),
+        );
+        if hovered || pressed {
+            window.paint_quad(
+                fill(
+                    action_bounds,
+                    if pressed {
+                        cx.theme().secondary_active
+                    } else {
+                        cx.theme().secondary_hover
+                    },
+                )
+                .corner_radii(Corners::all(px(4.))),
+            );
+        }
+        _ = label.paint(origin, line_height, window, cx);
+        action_bounds
     }

