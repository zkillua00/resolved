+++ b/src/highlighter/highlighter.rs	2026-08-26 22:41:41
@@ -628,6 +628,66 @@
 
         styles
     }
+
+    /// The language this highlighter was configured for.
+    pub fn language(&self) -> &SharedString {
+        &self.language
+    }
+
+    /// Natural-row fold candidates derived from the parsed syntax tree.
+    ///
+    /// Every named node spanning more than one line is a candidate. A child
+    /// whose row range is identical to its parent's is dropped, and a small
+    /// denylist of node kinds (document roots, error nodes, string literals,
+    /// raw text) never folds. Rows are 0-based natural lines with an inclusive
+    /// end, ordered outer-region-first so nesting can be derived by walking
+    /// forward.
+    pub fn fold_regions(&self) -> Vec<(usize, usize)> {
+        let Some(tree) = &self.tree else {
+            return Vec::new();
+        };
+
+        let root = tree.root_node();
+        if root.kind() == "ERROR" {
+            return Vec::new();
+        }
+
+        let mut raw = Vec::new();
+        let mut cursor = tree.walk();
+        for node in root.children(&mut cursor) {
+            collect_fold_nodes(node, &mut raw);
+        }
+
+        raw.sort_by(|a, b| a.0.cmp(&b.0).then(b.1.cmp(&a.1)));
+        raw.dedup();
+        raw
+    }
+}
+
+/// Node kinds that never fold, even when they span several lines.
+fn does_not_fold(kind: &str) -> bool {
+    matches!(
+        kind,
+        "document" | "source_file" | "program" | "module" | "translation_unit" | "ERROR" | "text"
+    ) || kind.contains("string")
+}
+
+/// Depth-first walk collecting multi-line node ranges.
+fn collect_fold_nodes(node: tree_sitter::Node, regions: &mut Vec<(usize, usize)>) {
+    if does_not_fold(node.kind()) {
+        return;
+    }
+    if node.child_count() > 0 {
+        let start = node.start_position().row;
+        let end = node.end_position().row;
+        if end > start {
+            regions.push((start, end));
+        }
+    }
+    let mut cursor = node.walk();
+    for child in node.children(&mut cursor) {
+        collect_fold_nodes(child, regions);
+    }
 }
 
