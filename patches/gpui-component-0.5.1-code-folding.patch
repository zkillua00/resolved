+/// Bind the per-level fold/unfold chords (⌘K ⌘1…9, ⌘K ⌘⇧1…9) — generated
+/// here to keep the main binding table readable.
+fn init_fold_level_bindings(cx: &mut App) {
+    #[cfg(target_os = "macos")]
+    let prefix = "cmd-k cmd-";
+    #[cfg(not(target_os = "macos"))]
+    let prefix = "ctrl-k ctrl-";
+
+    for level in 1..=9u32 {
+        let fold = format!("{prefix}{level}");
+        cx.bind_keys([KeyBinding::new(&fold, FoldLevel { level }, Some(CONTEXT))]);
+
+        let unfold = format!("{prefix}shift-{level}");
+        cx.bind_keys([KeyBinding::new(
+            &unfold,
+            UnfoldLevel { level },
+            Some(CONTEXT),
+        )]);
+    }
+}
