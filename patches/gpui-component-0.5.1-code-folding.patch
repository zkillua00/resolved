+    /// Recompute fold regions from the current text and syntax tree,
+    /// preserving which regions the user had collapsed (anchored by start row).
+    ///
+    /// The highlighter keeps an incrementally-updated tree, so this is a cheap
+    /// traversal after every edit rather than a fresh parse.
+    fn recompute_folds(&mut self) {
+        self.folds.regions.clear();
+        if !self.mode.is_code_editor() {
+            self.folds.refresh_hidden();
+            return;
+        }
