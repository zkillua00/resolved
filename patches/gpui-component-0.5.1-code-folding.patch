diff --git a/src/input/folding.rs b/src/input/folding.rs
--- a/src/input/folding.rs	1970-01-01 04:00:00
+++ b/src/input/folding.rs	2026-08-26 22:41:41
@@ -0,0 +1,262 @@
+//! Code folding support for the code-editor input.
+//!
+//! A document is subdivided into foldable [`FoldRegion`]s (nested structures:
+//! objects, arrays, functions, blocks, ...). Regions are addressed in 0-based
+//! **natural** (non-wrapped) line rows with an inclusive `end_row`. A region's
+//! header is its `start_row`; while folded and visible, every row in
+//! `start_row + 1 ..= end_row` is hidden from display.
+//!
+//! The module is intentionally free of GPUI types so the fold algebra
+//! (shadowing, depth, hit-testing) is directly unit-testable.
+
+use std::collections::BTreeSet;
+
+/// A foldable region of a document, in 0-based natural line rows
+/// (`end_row` inclusive).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FoldRegion {
+    pub start_row: usize,
+    pub end_row: usize,
+    /// Whether the user has collapsed this region.
+    pub folded: bool,
+}
+
+impl FoldRegion {
+    pub fn new(start_row: usize, end_row: usize) -> Self {
+        Self {
+            start_row,
+            end_row,
+            folded: false,
+        }
+    }
+
+    /// Number of natural rows covered by the region (header included).
+    pub fn rows_len(&self) -> usize {
+        self.end_row.saturating_sub(self.start_row) + 1
+    }
+
+    /// True when this region actually hides interior rows when folded.
+    pub fn is_foldable(&self) -> bool {
+        self.end_row > self.start_row
+    }
+}
+
+/// Compute the set of natural rows hidden by the currently active folds.
+///
+/// A fold only hides its interior while every enclosing fold is also active:
+/// a region whose header lives inside another collapsed region is shadowed and
+/// has nothing to contribute (its header is not displayed). Regions that share
+/// a header line (e.g. an object and the array nested on the same header) are
+/// all considered at the same outline level and never shadow one another.
+pub fn hidden_rows(regions: &[FoldRegion]) -> BTreeSet<usize> {
+    let mut hidden = BTreeSet::new();
+    for region in regions {
+        if !region.is_foldable() || !region.folded {
+            continue;
+        }
+        if hidden.contains(&region.start_row) {
+            continue;
+        }
+        for row in region.start_row + 1..=region.end_row {
+            hidden.insert(row);
+        }
+    }
+    hidden
+}
+
+/// The outline depth of the region at `index`, 1 for the outermost level.
+///
+/// A region's ancestors are the regions that cover its header and span
+/// strictly further down, so siblings on a shared header line do not inflate
+/// each other's depth.
+pub fn region_depth(regions: &[FoldRegion], index: usize) -> usize {
+    let Some(region) = regions.get(index) else {
+        return 0;
+    };
+    1 + regions
+        .iter()
+        .enumerate()
+        .filter(|(ix, other)| {
+            *ix != index
+                && other.start_row <= region.start_row
+                && other.start_row <= region.end_row
+                && other.end_row > region.end_row
+        })
+        .count()
+}
+
+/// The deepest region covering `row` (inclusive), if any.
+///
+/// The innermost region is the one with the smallest span; ties are broken by
+/// preferring the region starting later on the shared line.
+pub fn innermost_region_at(regions: &[FoldRegion], row: usize) -> Option<usize> {
+    let mut best: Option<(usize, usize)> = None;
+    for (ix, region) in regions.iter().enumerate() {
+        if region.start_row > row || region.end_row < row {
+            continue;
+        }
+        let span = region.rows_len();
+        match best {
+            Some((best_ix, best_span)) => {
+                if span < best_span
+                    || (span == best_span && region.start_row > regions[best_ix].start_row)
+                {
+                    best = Some((ix, span));
+                }
+            }
+            None => best = Some((ix, span)),
+        }
+    }
+    best.map(|(ix, _)| ix)
+}
+
+/// Compute fold regions from indentation alone.
+///
+/// A region starts on a non-blank line whose next non-blank line is indented
+/// deeper, and ends at the last line (inclusive) still indented deeper than the
+/// header, tolerating blank lines inside the block. Deeper indentation yields
+/// nested regions naturally.
+pub fn indentation_fold_regions(lines: &[&str]) -> Vec<FoldRegion> {
+    fn indent_width(line: &str) -> usize {
+        let mut width: usize = 0;
+        for ch in line.chars() {
+            match ch {
+                ' ' => width += 1,
+                '\t' => width = width.div_ceil(4) * 4,
+                _ => break,
+            }
+        }
+        width
+    }
+
+    let mut regions = Vec::new();
+    for (i, line) in lines.iter().enumerate() {
+        if line.trim().is_empty() {
+            continue;
+        }
+        let indent = indent_width(line);
+
+        let mut end = i;
+        let mut k = i + 1;
+        while k < lines.len() {
+            let next = lines[k];
+            if next.trim().is_empty() {
+                k += 1;
+                continue;
+            }
+            if indent_width(next) > indent {
+                end = k;
+                k += 1;
+                continue;
+            }
+            break;
+        }
+
+        if end > i {
+            regions.push(FoldRegion::new(i, end));
+        }
+    }
+    regions
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn folded(regions: &mut [FoldRegion], start_row: usize) {
+        if let Some(r) = regions.iter_mut().find(|r| r.start_row == start_row) {
+            r.folded = true;
+        }
+    }
+
+    #[test]
+    fn hidden_rows_respects_shadowing_by_ancestors() {
+        let mut regions = vec![
+            FoldRegion::new(0, 6), // outer
+            FoldRegion::new(1, 5), // nested block
+            FoldRegion::new(2, 3), // nested-nested
+        ];
+        folded(&mut regions, 1);
+        folded(&mut regions, 2);
+
+        // Folding the child alone hides only its own interior.
+        let hidden = hidden_rows(&regions);
+        assert!(hidden.contains(&2));
+        assert!(hidden.contains(&3));
+        assert!(!hidden.contains(&1));
+        assert!(!hidden.contains(&4));
+
+        // Once the outer region is folded too, the child header is shadowed and
+        // everything through the outer end is hidden.
+        folded(&mut regions, 0);
+        let hidden = hidden_rows(&regions);
+        assert_eq!(hidden.len(), 6);
+        assert!(hidden.contains(&1));
+        assert!(hidden.contains(&6));
+    }
+
+    #[test]
+    fn regions_sharing_a_header_line_do_not_shadow_each_other() {
+        let mut regions = vec![
+            FoldRegion::new(0, 9), // outer object
+            FoldRegion::new(0, 4), // array on the same header line
+        ];
+        folded(&mut regions, 0);
+        folded(&mut regions, 1);
+
+        let hidden = hidden_rows(&regions);
+        // Both headers stay visible; interiors combined.
+        assert!(!hidden.contains(&0));
+        assert!(hidden.contains(&1) && hidden.contains(&4));
+        assert!(hidden.contains(&5) && hidden.contains(&9));
+    }
+
+    #[test]
+    fn depth_counts_only_strict_ancestors() {
+        let regions = vec![
+            FoldRegion::new(0, 9),
+            FoldRegion::new(0, 4),
+            FoldRegion::new(2, 3),
+            FoldRegion::new(5, 8),
+        ];
+        // Outer object: depth 1. Same-line array is a sibling, not an ancestor.
+        assert_eq!(region_depth(&regions, 0), 1);
+        assert_eq!(region_depth(&regions, 1), 1);
+        assert_eq!(region_depth(&regions, 2), 2);
+        assert_eq!(region_depth(&regions, 3), 2);
+    }
+
+    #[test]
+    fn innermost_region_prefers_smaller_span() {
+        let regions = vec![
+            FoldRegion::new(0, 9),
+            FoldRegion::new(0, 4),
+            FoldRegion::new(2, 3),
+        ];
+        assert_eq!(innermost_region_at(&regions, 0), Some(1));
+        assert_eq!(innermost_region_at(&regions, 2), Some(2));
+        assert_eq!(innermost_region_at(&regions, 9), Some(0));
+        assert_eq!(innermost_region_at(&regions, 10), None);
+    }
+
+    #[test]
+    fn indentation_folding_nests_deeper_blocks() {
+        let text = ["root", "    child1", "        grand", "    child2", "tail"];
+        let regions = indentation_fold_regions(&text);
+        assert_eq!(regions, vec![FoldRegion::new(0, 3), FoldRegion::new(1, 2)]);
+    }
+
+    #[test]
+    fn indentation_folding_tolerates_blank_lines_inside_blocks() {
+        let text = ["a", "    b", "", "    c", "d"];
+        let regions = indentation_fold_regions(&text);
+        assert_eq!(regions, vec![FoldRegion::new(0, 3)]);
+    }
+
+    #[test]
+    fn indentation_folding_skips_flat_and_blank_headers() {
+        let text = ["one", "two", "    three", "four", ""];
+        let regions = indentation_fold_regions(&text);
+        assert_eq!(regions, vec![FoldRegion::new(1, 2)]);
+    }
+}
