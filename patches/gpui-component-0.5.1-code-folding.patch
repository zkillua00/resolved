+            .folds
+            .regions
+            .iter()
+            .filter(|r| r.folded)
+            .map(|r| r.start_row)
+            .collect();
+
+        self.folds.regions = candidates
+            .into_iter()
+            .map(|(start_row, end_row)| FoldRegion {
