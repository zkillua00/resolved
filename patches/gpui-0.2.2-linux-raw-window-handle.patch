 impl rwh::HasWindowHandle for X11Window {
     fn window_handle(&self) -> Result<rwh::WindowHandle<'_>, rwh::HandleError> {
-        unimplemented!()
+        // Wry's WebKitGTK child-window backend accepts an Xlib handle. Xlib
+        // and XCB use the same numeric XID, so exposing this window as Xlib
+        // is valid even though GPUI owns it through XCB.
+        let handle = rwh::XlibWindowHandle::new(self.0.x_window.into());
+        Ok(unsafe { rwh::WindowHandle::borrow_raw(handle.into()) })
     }
 }
 impl rwh::HasDisplayHandle for X11Window {
     fn display_handle(&self) -> Result<rwh::DisplayHandle<'_>, rwh::HandleError> {
-        unimplemented!()
+        let connection =
+            as_raw_xcb_connection::AsRawXcbConnection::as_raw_xcb_connection(&self.0.xcb)
+                as *mut _;
+        let Some(connection) = NonNull::new(connection) else {
+            log::error!("Null X11Window XCB connection when getting display handle.");
+            return Err(rwh::HandleError::Unavailable);
+        };
+        let screen_id = self.0.state.borrow().screen_id as i32;
+        let handle = rwh::XcbDisplayHandle::new(Some(connection), screen_id);
+        Ok(unsafe { rwh::DisplayHandle::borrow_raw(handle.into()) })
     }
 }
