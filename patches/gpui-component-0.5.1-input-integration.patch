+fn previous_word_start_in_line(line_start: usize, text_before_cursor: &str) -> usize {
+    UnicodeSegmentation::split_word_bound_indices(text_before_cursor)
+        .rfind(|(_, segment)| !segment.trim_start().is_empty())
+        .map(|(offset, _)| line_start + offset)
+        .unwrap_or(line_start)
+}
+
+fn previous_line_break_start(text: &Rope, line_start: usize) -> usize {
+    if line_start == 0 {
+        return 0;
+    }
+
+    let newline_start = text.clip_offset(line_start - 1, Bias::Left);
+    if text.char_at(newline_start) == Some('\n') && newline_start > 0 {
+        let possible_carriage_return = text.clip_offset(newline_start - 1, Bias::Left);
+        if text.char_at(possible_carriage_return) == Some('\r') {
+            return possible_carriage_return;
+        }
+    }
+    newline_start
+}
