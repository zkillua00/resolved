+/// Return the UTF-8 offset at or before the previous visual tab stop.
+///
+/// `text_before_cursor` must be from the beginning of the current line to the
+/// cursor. A tab that spans the target stop is removed in full, which keeps
+/// mixed space/tab indentation deterministic.
+pub(super) fn previous_tab_stop_offset(
+    line_start: usize,
+    text_before_cursor: &str,
+    tab: TabSize,
+) -> usize {
+    let width = tab.width();
+    let current_column = visual_column(text_before_cursor, tab);
+    if current_column == 0 {
+        return line_start;
+    }
+
+    let target_column = ((current_column - 1) / width) * width;
+    let mut column = 0;
+    let mut relative_offset = 0;
+    for (offset, character) in text_before_cursor.char_indices() {
+        let next_column = if character == '\t' {
+            column + width - column % width
+        } else {
+            column + 1
+        };
+        if next_column > target_column {
+            break;
+        }
+        column = next_column;
+        relative_offset = offset + character.len_utf8();
+    }
+
+    line_start + relative_offset
+}
