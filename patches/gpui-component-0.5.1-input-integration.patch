+/// also deleting the word before it. Brackets also stop a deletion that would
+/// otherwise consume both the bracket and adjacent whitespace.
+fn adjust_backward_deletion_start(text_before_cursor: &str, candidate: usize) -> usize {
+    let deletion = &text_before_cursor[candidate..];
+    let mut bracket_boundary = 0;
+    for (offset, character) in deletion.char_indices() {
+        if !is_bracket(character) {
+            continue;
+        }
