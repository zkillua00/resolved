+/// Overlay application-owned semantic styles in a stable order.
+///
+/// GPUI's general-purpose `combine_highlights` intentionally treats active
+/// styles as an unordered set. That is fine for independent attributes, but
+/// semantic template colors must win over a syntax foreground color
+/// deterministically. The base styles cover the visible byte range, so each
+/// semantic range can be applied by splitting the affected base segments.
+fn overlay_semantic_highlights(
+    mut base: Vec<(Range<usize>, HighlightStyle)>,
+    overlays: impl IntoIterator<Item = (Range<usize>, HighlightStyle)>,
+) -> Vec<(Range<usize>, HighlightStyle)> {
+    for (overlay_range, overlay_style) in overlays {
+        if overlay_range.is_empty() {
+            continue;
+        }
+
+        let mut next = Vec::with_capacity(base.len() + 2);
+        for (range, style) in base {
+            if range.end <= overlay_range.start || range.start >= overlay_range.end {
+                next.push((range, style));
+                continue;
+            }
+
+            let overlap_start = range.start.max(overlay_range.start);
+            let overlap_end = range.end.min(overlay_range.end);
+            if range.start < overlap_start {
+                next.push((range.start..overlap_start, style));
+            }
+
+            let mut combined = style.highlight(overlay_style);
+            if overlay_style.color.is_some() {
+                combined.color = overlay_style.color;
+            }
+            next.push((overlap_start..overlap_end, combined));
+
+            if overlap_end < range.end {
+                next.push((overlap_end..range.end, style));
+            }
+        }
+        base = next;
+    }
+    base
+}
