+#[cfg(test)]
+mod word_boundary_tests {
+    use super::{
+        is_matching_bracket_pair, paired_newline_text, previous_deletion_start_in_line,
+        previous_line_break_start, previous_word_start_in_line,
+    };
+    use crate::input::TabSize;
+    use ropey::Rope;
+
+    #[test]
+    fn previous_word_stays_within_the_current_line() {
+        assert_eq!(previous_word_start_in_line(0, "alpha beta gamma"), 11);
+        assert_eq!(previous_word_start_in_line(7, "    next"), 11);
+        assert_eq!(previous_word_start_in_line(7, "    "), 7);
+
+        let url = "https://httpbin.org/get";
+        assert_eq!(
+            previous_word_start_in_line(0, url),
+            url.rfind("get").unwrap()
+        );
+    }
+
+    #[test]
+    fn previous_word_uses_utf8_byte_offsets() {
+        let text = "éclair 😀 中";
+        assert_eq!(
+            previous_word_start_in_line(0, text),
+            text.rfind('中').unwrap()
+        );
+    }
+
+    #[test]
+    fn word_movement_remains_greedy_while_deletion_stops_at_ergonomic_boundaries() {
+        assert_eq!(previous_word_start_in_line(0, "alpha   "), 0);
+        assert_eq!(previous_deletion_start_in_line(0, "alpha "), 0);
+        assert_eq!(previous_deletion_start_in_line(0, "alpha   "), 5);
+        assert_eq!(previous_deletion_start_in_line(0, "alpha\t "), 5);
+        assert_eq!(previous_deletion_start_in_line(0, "alpha( "), 6);
+        assert_eq!(previous_deletion_start_in_line(0, "alpha() "), 7);
+        assert_eq!(previous_deletion_start_in_line(0, "alpha()"), 6);
+        assert_eq!(previous_word_start_in_line(0, "items.map"), 6);
+        assert_eq!(previous_deletion_start_in_line(0, "items.map"), 6);
+    }
+
+    #[test]
+    fn line_break_is_deleted_without_crossing_into_the_previous_line() {
+        assert_eq!(previous_line_break_start(&Rope::from("alpha\n"), 6), 5);
+        assert_eq!(previous_line_break_start(&Rope::from("alpha\r\n"), 7), 5);
+        assert_eq!(previous_line_break_start(&Rope::from("é\n"), 3), 2);
+        assert_eq!(previous_line_break_start(&Rope::from("alpha"), 0), 0);
+    }
+
+    #[test]
+    fn paired_brackets_get_an_indented_interior_line() {
+        for pair in [('{', '}'), ('[', ']'), ('(', ')')] {
+            assert!(is_matching_bracket_pair(Some(pair.0), Some(pair.1)));
+        }
+        assert!(!is_matching_bracket_pair(Some('{'), Some(']')));
+
+        let (text, caret_offset) = paired_newline_text(
+            "  ",
+            TabSize {
+                tab_size: 2,
+                hard_tabs: false,
+            },
+        );
+        assert_eq!(text, "\n    \n  ");
+        assert_eq!(caret_offset, 5);
+    }
+}
