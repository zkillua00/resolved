+fn matching_label_prefix_len(label: &str, query: &str) -> usize {
+    let mut matched_len = 0;
+    for ((byte_offset, label_character), query_character) in label.char_indices().zip(query.chars())
+    {
+        if !label_character.eq_ignore_ascii_case(&query_character) {
+            break;
+        }
+        matched_len = byte_offset + label_character.len_utf8();
+    }
+    matched_len
