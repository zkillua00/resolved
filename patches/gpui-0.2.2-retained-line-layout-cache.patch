+// Fast scrolling can move a line out of GPUI's two-frame cache and back into
+// view before the gesture ends. Keep a bounded history so those lines reuse
+// their glyph layout instead of reaching CoreText again.
+const RETAINED_LAYOUT_CAPACITY: usize = 2_048;
+
+#[derive(Default)]
+struct RetainedCache {
+    lines: FxHashMap<Arc<CacheKey>, Arc<LineLayout>>,
+    wrapped_lines: FxHashMap<Arc<CacheKey>, Arc<WrappedLineLayout>>,
+    line_order: VecDeque<Arc<CacheKey>>,
+    wrapped_line_order: VecDeque<Arc<CacheKey>>,
+}
+
+impl RetainedCache {
+    fn line(&self, key: &dyn AsCacheKeyRef) -> Option<(Arc<CacheKey>, Arc<LineLayout>)> {
+        self.lines
+            .get_key_value(key)
+            .map(|(key, layout)| (key.clone(), layout.clone()))
+    }
+
+    fn wrapped_line(
+        &self,
+        key: &dyn AsCacheKeyRef,
+    ) -> Option<(Arc<CacheKey>, Arc<WrappedLineLayout>)> {
+        self.wrapped_lines
+            .get_key_value(key)
+            .map(|(key, layout)| (key.clone(), layout.clone()))
+    }
+
+    fn insert_line(&mut self, key: Arc<CacheKey>, layout: Arc<LineLayout>) {
+        if self.lines.insert(key.clone(), layout).is_some() {
+            return;
+        }
+        self.line_order.push_back(key);
+        while self.lines.len() > RETAINED_LAYOUT_CAPACITY {
+            if let Some(key) = self.line_order.pop_front() {
+                self.lines.remove(&key);
+            }
+        }
+    }
+
+    fn insert_wrapped_line(&mut self, key: Arc<CacheKey>, layout: Arc<WrappedLineLayout>) {
+        if self.wrapped_lines.insert(key.clone(), layout).is_some() {
+            return;
+        }
+        self.wrapped_line_order.push_back(key);
+        while self.wrapped_lines.len() > RETAINED_LAYOUT_CAPACITY {
+            if let Some(key) = self.wrapped_line_order.pop_front() {
+                self.wrapped_lines.remove(&key);
+            }
+        }
+    }
+}
