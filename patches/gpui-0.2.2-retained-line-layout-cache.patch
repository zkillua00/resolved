+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cache_key(text: String) -> Arc<CacheKey> {
+        Arc::new(CacheKey {
+            text: text.into(),
+            font_size: px(13.),
+            runs: SmallVec::new(),
+            wrap_width: None,
+            force_width: None,
+        })
+    }
+
+    #[test]
+    fn retained_line_cache_is_bounded_and_reuses_recent_layouts() {
+        let mut cache = RetainedCache::default();
+        let first_key = cache_key("line-0".to_owned());
+        let last_key = cache_key(format!("line-{RETAINED_LAYOUT_CAPACITY}"));
+
+        for index in 0..=RETAINED_LAYOUT_CAPACITY {
+            let key = if index == 0 {
+                first_key.clone()
+            } else if index == RETAINED_LAYOUT_CAPACITY {
+                last_key.clone()
+            } else {
+                cache_key(format!("line-{index}"))
+            };
+            cache.insert_line(key, Arc::new(LineLayout::default()));
+        }
+
+        assert_eq!(cache.lines.len(), RETAINED_LAYOUT_CAPACITY);
+        assert!(cache.line(first_key.as_ref()).is_none());
+        assert!(cache.line(last_key.as_ref()).is_some());
+    }
+}
