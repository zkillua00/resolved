 impl LineLayout {
+    pub(crate) fn set_tab_width(&mut self, text: &str, tab_width: Pixels) {
+        if tab_width <= px(0.) || !text.contains('\t') {
+            return;
+        }
+
+        let original = self.clone();
+        let mut accumulated_shift = px(0.);
+        for (tab_index, character) in text.char_indices() {
+            if character != '\t' {
+                continue;
+            }
+
+            let start = original.x_for_index(tab_index) + accumulated_shift;
+            let actual_end =
+                original.x_for_index(tab_index + character.len_utf8()) + accumulated_shift;
+            let desired_end = start + tab_width - start % tab_width;
+            let shift = desired_end - actual_end;
+            if shift == px(0.) {
+                continue;
+            }
+
+            for run in &mut self.runs {
+                for glyph in &mut run.glyphs {
+                    if glyph.index > tab_index {
+                        glyph.position.x += shift;
+                    }
+                }
+            }
+            self.width += shift;
+            accumulated_shift += shift;
+        }
+    }
