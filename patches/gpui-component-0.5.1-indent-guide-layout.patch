+/// Return the byte offsets where indentation guides start.
+///
+/// The painter projects these offsets through the shaped line instead of
+/// estimating x positions from a separate run of spaces. That keeps guides
+/// aligned when the platform lays out a hard tab differently from spaces.
+fn indent_guide_offsets(line: &RopeSlice, tab: TabSize) -> Vec<usize> {
+    let width = tab.width();
+    let mut boundaries = vec![(0, 0)];
+    let mut column = 0;
+    let mut byte_offset = 0;
+
+    for character in line.chars() {
+        column = match character {
+            '\t' => column + width - column % width,
+            ' ' => column + 1,
+            _ => break,
+        };
+        byte_offset += character.len_utf8();
+        boundaries.push((column, byte_offset));
+    }
+
+    (0..column)
+        .step_by(width)
+        .map(|target| {
+            boundaries
+                .iter()
+                .find_map(|(column, offset)| (*column >= target).then_some(*offset))
+                .unwrap_or(byte_offset)
+        })
+        .collect()
+}
