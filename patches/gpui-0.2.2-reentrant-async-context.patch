+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::TestAppContext;
+
+    #[test]
+    fn update_entity_returns_error_during_reentrant_app_borrow() {
+        let mut cx = TestAppContext::single();
+        let entity = cx.new(|_| 0usize);
+        let mut async_cx = cx.to_async();
+
+        cx.update(|_| {
+            let result = entity.update(&mut async_cx, |value, _| *value += 1);
+            assert!(result.is_err());
+        });
+
+        assert_eq!(cx.read(|cx| *entity.read(cx)), 0);
+    }
+}
